{
  "extends": "stylelint-config-standard-scss",
  "rules": {
    "selector-class-pattern": "^[a-z]([a-z0-9-]+)?(__([a-z0-9]+-?)+)?(--([a-z0-9]+-?)+){0,2}$",
    "max-nesting-depth": 3,
    "declaration-no-important": true,
    "color-hex-length": "short",
    "color-named": "never",
    "selector-max-id": 0,
    "selector-no-qualifying-type": [true, {
      "ignore": ["attribute", "class"]
    }]
  }
}
