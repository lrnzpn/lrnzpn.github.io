{
  "name": "lrnzportfolio",
  "version": "1.0.0",
  "description": "Welcome to Lorenzo's portfolio site",
  "main": "src/index.js",
  "scripts": {
    "dev": "webpack serve --config config/webpack.dev.js --open",
    "build": "webpack --config config/webpack.prod.js",
    "build:prod": "npm run lint && npm run test && npm run build",
    "deploy": "npm run build:prod && gh-pages -d dist",
    "predeploy": "npm run build:prod",
    "test": "jest --config config/jest.config.js",
    "test:watch": "jest --config config/jest.config.js --watch",
    "test:coverage": "jest --config config/jest.config.js --coverage",
    "lint": "eslint src/**/*.js && stylelint src/**/*.scss",
    "lint:fix": "eslint src/**/*.js --fix && stylelint src/**/*.scss --fix",
    "format": "prettier --write \"src/**/*.{js,scss,json}\"",
    "analyze": "webpack --config config/webpack.prod.js --profile --json > stats.json && webpack-bundle-analyzer stats.json",
    "prepare": "husky install"
  },
  "homepage": "https://lrnzpn.github.io/lrnzportfolio",
  "keywords": [
    "portfolio",
    "vanilla-javascript",
    "component-architecture",
    "design-system",
    "performance",
    "accessibility"
  ],
  "author": "Lorenzo Pinaroc",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "dompurify": "^3.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.29.2",
    "@testing-library/dom": "^10.4.1",
    "autoprefixer": "^10.4.27",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.1.1",
    "compression-webpack-plugin": "^12.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.39.0",
    "css-loader": "^7.1.4",
    "cssnano": "^7.1.3",
    "eslint": "^10.1.0",
    "gh-pages": "^6.1.1",
    "html-webpack-plugin": "^5.6.6",
    "husky": "^9.1.7",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "imagemin": "^9.0.1",
    "imagemin-svgo": "^12.0.0",
    "imagemin-webp": "^8.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.4.0",
    "mini-css-extract-plugin": "^2.10.1",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "stylelint": "^17.5.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "terser-webpack-plugin": "^5.4.0",
    "webpack": "^5.105.4",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^6.0.1"
  }
}
